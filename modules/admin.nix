# shmulcode admin command: init / doctor / list / info.
#
# A second `writeShellApplication`, produced by the same flake and sharing the
# instance data and the resolution library with the launchers. Sharing is the
# point: `doctor` must reproduce the wrapper's decision exactly, or it lies.
#
# SECURITY: this command prints names, paths and stat fields only. It never
# echoes a provider variable's value (SEC-03).
{ lib, ... }:
let
  resolver = import ../lib/resolve-env-file.nix { inherit lib; };
  instances = import ./_instances.nix;
  names = builtins.attrNames instances;

  # Local name-safety gate: `namePattern` is injected as an unquoted `case`
  # pattern list, so a glob metacharacter in an instance name would corrupt the
  # allowlist. Do not rely on packages.nix's assertion alone.
  _nameSafe = lib.assertMsg
    (builtins.all (n: builtins.match "[A-Za-z0-9][A-Za-z0-9._-]*" n != null) names)
    "shmulcode admin: instance names must be safe shell tokens";

  namePattern = lib.concatStringsSep "|" names;
  requiredOf = n: instances.${n}.requiredVars or resolver.defaultRequiredVars;
  descriptionOf = n: instances.${n}.description or n;

  # init template: comments + commented-out export lines. NAMES only, no values.
  templateFor = n:
    let
      comment = g:
        if builtins.isList g
        then [ "#   one of: ${lib.concatStringsSep " or " g}" ] ++ map (v: "# export ${v}=") g
        else [ "#   export ${g}=" ];
      lines =
        [
          "# ${descriptionOf n}"
          "#"
          "# Created by 'shmulcode init ${n}' with mode 600."
          "# Required variables (fill in values from your provider dashboard):"
        ]
        ++ lib.concatMap comment (requiredOf n)
        ++ [
          "#"
          "# This file is sourced as shell by the ${n} launcher; keep it to simple export lines."
          "# Never commit it."
        ];
    in
    lib.concatStringsSep "\n" lines;

  # Description lookup for `list` (quoted so an apostrophe survives shellcheck).
  descCases = lib.concatMapStrings
    (n: "    ${n}) echo ${lib.escapeShellArg (descriptionOf n)} ;;\n")
    names;

  # init template writer, one case branch per instance.
  templateCases = lib.concatMapStrings
    (n: "    ${n}) printf '%s\\n' ${lib.escapeShellArg (templateFor n)} >> \"$env_file\" ;;\n")
    names;

  # presence-only report lines for doctor (never values).
  presenceLines = n:
    lib.concatMapStringsSep "\n"
      (g:
        if builtins.isList g then
          let
            lab = lib.concatStringsSep "/" g;
            cond = lib.concatMapStringsSep " || " (v: "[ -n \"\${${v}:-}\" ]") g;
          in
          "    if ${cond}; then echo \"    ${lab}: set\"; else echo \"    ${lab}: unset\"; fi"
        else
          "    if [ -n \"\${${g}:-}\" ]; then echo \"    ${g}: set\"; else echo \"    ${g}: unset\"; fi")
      (requiredOf n);

  # required-variable checks, generated by the SAME library the launcher uses.
  requiredCheckLines = n:
    lib.concatMapStrings (l: "      " + l + "\n")
      (lib.splitString "\n" (resolver.mkRequiredChecks (requiredOf n)));

  presenceCases = lib.concatMapStrings
    (n: "    ${n})\n" + presenceLines n + "\n      ;;\n")
    names;

  requiredCases = lib.concatMapStrings
    (n: "    ${n})\n" + requiredCheckLines n + "      ;;\n")
    names;
in
assert _nameSafe;
{
  perSystem = { pkgs, ... }: {
    packages.shmulcode = pkgs.writeShellApplication {
      name = "shmulcode";
      runtimeInputs = [ pkgs.coreutils ];
      meta = {
        description = "shmulcode — env-file resolution and instance diagnostics";
        mainProgram = "shmulcode";
      };
      text = ''
        usage() {
          printf '%s\n' \
            'usage: shmulcode <command> [<instance>]' \
            "" \
            'commands:' \
            '  init <name>     create a 0600 commented env-file template' \
            '  doctor <name>   explain env-file resolution and variable presence' \
            '  list            list instances and their env state' \
            "  info <name>     alias for 'doctor <name>'" \
            "" \
            'instances: ${lib.concatStringsSep " " names}' >&2
        }

        require_instance() {
          case "''${1:-}" in
            ${namePattern}) : ;;
            "") echo "shmulcode: missing instance name" >&2; usage; exit 64 ;;
            *) echo "shmulcode: unknown instance: ''${1:-}" >&2; usage; exit 64 ;;
          esac
        }

        # Sets env_file + origin exactly as the launcher does. Caller sets `name`
        # (already allowlist-validated), so a crafted name can never reach this path.
        resolve_env() {
          ${resolver.mkResolution { nameExpr = "$name"; errorLabel = "$name"; }}
        }

        desc_for() {
          case "$1" in
        ${descCases}    esac
        }

        cmd_init() {
          name="$1"
          resolve_env
          if [ -e "$env_file" ] || [ -L "$env_file" ]; then
            echo "shmulcode: refusing to overwrite existing env file: $env_file" >&2
            exit 73
          fi
          if ! mkdir -p "$(dirname "$env_file")"; then
            echo "shmulcode: cannot create directory for: $env_file" >&2
            exit 73
          fi
          umask 077
          set -C
          if ! : > "$env_file"; then
            echo "shmulcode: cannot create env file: $env_file" >&2
            exit 73
          fi
          set +C
          case "$name" in
        ${templateCases}    esac
          chmod 600 "$env_file"
          echo "shmulcode: wrote $env_file (mode 600)"
          echo "shmulcode: fill in the values; the file is sourced as shell and never committed"
        }

        cmd_doctor() {
          name="$1"
          resolve_env
          echo "instance: $name"
          echo "resolved by: $origin"
          echo "env file: $env_file"

          if [ ! -e "$env_file" ] && [ ! -L "$env_file" ]; then
            echo "status: missing"
            echo "next: run 'shmulcode init $name'"
            exit 78
          fi
          if [ ! -f "$env_file" ]; then
            echo "status: not a regular file"
            exit 78
          fi
          ftype="$(stat -L -c '%F' "$env_file" 2>/dev/null || echo unknown)"
          mode="$(stat -L -c '%a' "$env_file" 2>/dev/null || true)"
          owner="$(stat -L -c '%U:%G' "$env_file" 2>/dev/null || echo unknown)"
          echo "type: $ftype"
          echo "mode: ''${mode:-unknown}"
          echo "owner: $owner"
          if [ -n "$mode" ] && (( (8#$mode & 8#077) != 0 )); then
            echo "warning: $env_file is group/world-accessible (mode $mode); chmod 600"
          fi
          if [ ! -r "$env_file" ]; then
            echo "status: not readable"
            exit 78
          fi

          # Mirror the wrapper's BOM/CRLF preflight (lib/mk-launcher.nix step 6).
          # Without this, doctor could say "usable, exit 0" for a file the
          # launcher rejects with 78 — the exact drift shared resolution prevents.
          if [[ "$(<"$env_file")" == $'\xef\xbb\xbf'* ]]; then
            echo "status: environment file starts with a UTF-8 BOM"
            exit 78
          fi
          if [[ "$(<"$env_file")" == *$'\r'* ]]; then
            echo "status: environment file contains CRLF line endings"
            exit 78
          fi

          # Mirror the wrapper: ambient provider vars would make doctor lie about
          # what the file defines, so drop them before sourcing.
          for __v in "''${!ANTHROPIC_@}"; do unset -- "$__v"; done
          unset __v

          set +u
          set -a
          # shellcheck source=/dev/null
          if ! . "$env_file"; then
            echo "status: failed to load env file"
            exit 78
          fi
          set +a
          set -u
          # Re-assert strict mode: the sourced file may have toggled these.
          set -o errexit

          echo "variables (presence only):"
          case "$name" in
        ${presenceCases}    esac

          missing=()
          case "$name" in
        ${requiredCases}    esac
          if [ "''${#missing[@]}" -ne 0 ]; then
            echo "status: missing required variables: ''${missing[*]}"
            exit 78
          fi

          echo "status: usable"
          echo "next: run 'claude doctor' for Claude Code's own diagnostics"
        }

        cmd_list() {
          for n in ${lib.concatStringsSep " " names}; do
            name="$n"
            resolve_env
            desc="$(desc_for "$name")"
            if [ -f "$env_file" ]; then
              mode="$(stat -L -c '%a' "$env_file" 2>/dev/null || true)"
              # Descriptions already begin with the instance name.
              printf '%s | env: %s (present, mode %s, via %s)\n' "$desc" "$env_file" "''${mode:-unknown}" "$origin"
            else
              printf '%s | env: %s (missing, via %s) — run: shmulcode init %s\n' "$desc" "$env_file" "$origin" "$name"
            fi
          done
        }

        main() {
          cmd="''${1:-}"
          case "$cmd" in
            "") usage; exit 64 ;;
            init) require_instance "''${2:-}"; cmd_init "$2" ;;
            doctor|info) require_instance "''${2:-}"; cmd_doctor "$2" ;;
            list) cmd_list ;;
            *) echo "shmulcode: unknown command: $cmd" >&2; usage; exit 64 ;;
          esac
        }

        main "$@"
      '';
    };
  };
}
